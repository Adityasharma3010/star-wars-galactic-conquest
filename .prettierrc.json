{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "plugins": ["./scripts/prettier-postgres-plugin.js", "prettier-plugin-toml"],
  "overrides": [
    {
      "files": "*.sql",
      "options": {
        "parser": "sql",
        "formatter": "sql-formatter",
        "language": "postgresql",
        "keywordCase": "preserve",
        "dataTypeCase": "preserve",
        "functionCase": "preserve",
        "identifierCase": "preserve"
      }
    },
    { "files": "*.toml", "options": { "parser": "toml" } },
    { "files": "*.svg", "options": { "parser": "html" } }
  ]
}
